# Copie para .env (NAO versionado) ou exporte no terminal. Valores de exemplo.
# PostgreSQL (local ou Render). Opcao 1: URL JDBC pronta.
# DB_URL=jdbc:postgresql://localhost:5432/vozdobairro
# Opcao 2: partes separadas (e o que o Render injeta).
DB_HOST=localhost
DB_PORT=5432
DB_NAME=vozdobairro
DB_USER=vozdobairro
DB_PASSWORD=sua-senha
JWT_SECRET=troque-por-um-segredo-com-pelo-menos-32-caracteres
RABBITMQ_URL=amqp://guest:guest@localhost:5672
# Opcional: sem OPENAI_API_KEY a API usa o fallback de resumo (sem IA).
# OPENAI_API_KEY=sk-...   (deixe comentado se nao tiver chave)
OPENAI_BASE_URL=https://api.openai.com
OPENAI_MODEL=gpt-4o-mini
